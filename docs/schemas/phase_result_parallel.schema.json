{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loker.dev/schemas/phase_result_parallel.schema.json",
  "title": "Phase Result - ParallelFanOut",
  "description": "Result file emitted by a phase running under the ParallelFanOut strategy. Each branch records the backend that ran (with the family bucket so the engine can enforce diversity policies), its usage, and its individual artefact path. The aggregator reduces N branch outputs into a single canonical artefact at aggregate_output_path; the verify hook runs against that aggregate.",
  "type": "object",
  "required": [
    "schema_version",
    "loker.strategy",
    "loker.phase",
    "loker.run_id",
    "branches",
    "aggregator",
    "aggregate_output_path",
    "verify"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "loker.strategy": { "type": "string", "const": "parallel" },
    "loker.phase": { "type": "string", "minLength": 1 },
    "loker.run_id": { "type": "string", "format": "uuid" },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/branch" }
    },
    "aggregator": {
      "type": "string",
      "enum": ["concat", "llm_judge", "any_fail", "vote"]
    },
    "aggregate_output_path": { "type": "string", "minLength": 1 },
    "verify": { "$ref": "#/$defs/verify" }
  },
  "additionalProperties": false,
  "$defs": {
    "branch": {
      "type": "object",
      "required": [
        "backend",
        "family",
        "model",
        "finish_reasons",
        "usage",
        "output_path"
      ],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "family": {
          "type": "string",
          "enum": ["anthropic", "google", "openai", "zhipu", "local"]
        },
        "model": { "type": "string", "minLength": 1 },
        "finish_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["stop", "length", "tool_calls", "content_filter", "error"]
          }
        },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "output_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "required": ["status", "hook"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "hook": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
