{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loker.dev/schemas/phase_result_single.schema.json",
  "title": "Phase Result - SingleModel",
  "description": "Result file emitted by a phase running under the SingleModel strategy. Exactly one attempt entry is recorded, capturing the backend that produced the canonical artefact, its token usage, the path to the artefact within the run dir, and the verify hook outcome.",
  "type": "object",
  "required": [
    "schema_version",
    "loker.strategy",
    "loker.phase",
    "loker.run_id",
    "attempts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "loker.strategy": { "type": "string", "const": "single" },
    "loker.phase": { "type": "string", "minLength": 1 },
    "loker.run_id": { "type": "string", "format": "uuid" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "attempt": {
      "type": "object",
      "required": [
        "backend",
        "model",
        "finish_reasons",
        "usage",
        "output_path",
        "verify"
      ],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "finish_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["stop", "length", "tool_calls", "content_filter", "error"]
          }
        },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "output_path": { "type": "string", "minLength": 1 },
        "verify": {
          "type": "object",
          "required": ["status", "hook"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pass", "fail", "skipped"]
            },
            "hook": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
