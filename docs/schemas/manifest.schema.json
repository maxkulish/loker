{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loker.dev/schemas/manifest.schema.json",
  "title": "Loker Run Manifest",
  "description": "Append-only artefact registry persisted at runs/<id>/manifest.json (PRD FR-23b). Each entry is content-addressed by sha256 so the resume path can detect tampering or partial writes. Entries are added phase-by-phase; an empty entries array is legal between run start and the first phase artefact landing.",
  "type": "object",
  "required": ["loker.run_id", "loker.schema_version", "entries"],
  "properties": {
    "loker.run_id": {
      "type": "string",
      "format": "uuid"
    },
    "loker.schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the manifest schema this file conforms to."
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["name", "kind", "schema_version", "sha256", "producer"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the artefact relative to the run directory (e.g., design/design.md, verify/01.json)."
        },
        "kind": {
          "type": "string",
          "enum": [
            "design.md",
            "review.md",
            "verify.json",
            "phase_result.json",
            "pending.json",
            "response.json",
            "summary.json",
            "changes/",
            "trace.jsonl"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex sha256 of the artefact bytes at the moment of the manifest write."
        },
        "producer": {
          "type": "string",
          "enum": ["single", "parallel", "escalating", "verify", "hitl"]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
