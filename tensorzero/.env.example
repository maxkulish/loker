# Copy to .env before `docker compose up`.
# OPENAI_API_KEY must be set to a real key for the stack to start cleanly.
# ANTHROPIC_API_KEY may be left unset for startup (compose provides a
# placeholder default) but must be a real key to capture a successful
# Anthropic fixture.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
