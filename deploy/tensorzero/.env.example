# Copy to .env before `docker compose up`.
# OPENAI_API_KEY must be set to a real key for the stack to start cleanly.
# ANTHROPIC_API_KEY and GEMINI_API_KEY may be left unset for startup (compose
# provides placeholder defaults) but must be real keys for requests to
# the respective providers to succeed.
# GEMINI_API_KEY is exposed to the gateway as GOOGLE_AI_STUDIO_API_KEY
# (tensorzero's expected env name for the Google AI Studio provider).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
